  ini [shape=circle, label="", style=filled, fillcolor=black, width=0.2];
  pan [label="En Pañol\n(disponible)", fillcolor="#DDF3E6", color="#1B7F4B"];
  loc [label="En Uso Local\n(oficina)", fillcolor="#DCE6FF", color="#1B4DB3"];
  ext [label="En Uso Externo\n(Home Office)", fillcolor="#EBDDFF", color="#6B3FB8"];
  srv [label="En Servicio Técnico\n(fuera de circulación)", fillcolor="#FFDAD6", color="#B3261E"];
  ini -> pan [label="CU-01 alta"];
